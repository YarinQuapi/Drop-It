// Prisma ORM 7 with the MySQL provider. Prisma ORM 8 does not ship a MySQL
// library yet (documented as coming soon), so this is the supported Prisma + MySQL path.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Language {
  en
  he
}

enum Sex {
  male
  female
}

enum ActivityLevel {
  sedentary
  light
  moderate
  very
  extra
}

enum WeeklyPace {
  kg025
  kg050
  kg100
}

enum FoodBasis {
  solid
  liquid
}

enum MealCategory {
  breakfast
  lunch
  dinner
  snacks
}

enum Role {
  user
  admin
}

enum WeightSource {
  manual
  health
}

model RolePermission {
  role      Role
  operation String
  allowed   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@id([role, operation])
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String?
  appleSub         String?  @unique
  language         Language @default(en)
  isAdmin          Boolean  @default(false)
  autoPublishFoods Boolean  @default(false)
  createdAt        DateTime @default(now())

  sessions        Session[]
  profile         Profile?
  dailyGoals      DailyGoal[]
  diaryEntries    DiaryEntry[]
  weights         WeightEntry[]
  foods           Food[]           @relation("FoodOwner")
  verifiedFoods   Food[]           @relation("VerifiedBy")
  fastingSettings FastingSettings?
  fastingTimer    FastingTimer?
  fastingSessions FastingSession[]
  healthSettings  HealthSettings?
  healthDays      HealthDay[]
  scanReports     ScanReport[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  userId      String        @id
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex         Sex
  dateOfBirth DateTime      @db.Date
  heightCm    Decimal       @db.Decimal(5, 1)
  weightKg    Decimal       @db.Decimal(6, 2)
  activity        ActivityLevel
  weeklyPace      WeeklyPace
  customGoalKcal  Int?
  updatedAt       DateTime      @updatedAt
}

model DailyGoal {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  goalKcal Int
  // True when goalKcal is the sedentary base because Apple Health is connected. Active calories do not change it.
  healthAdjusted Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

model Food {
  id            String    @id @default(cuid())
  // Null for loose foods (fruit, home cooking). Unique per owner when set.
  barcode       String?
  name          String
  ownerId       String
  owner         User      @relation("FoodOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  basis         FoodBasis
  calories      Decimal   @db.Decimal(8, 2)
  protein       Decimal   @db.Decimal(8, 2)
  carbohydrates Decimal   @db.Decimal(8, 2)
  fat           Decimal   @db.Decimal(8, 2)
  fiber         Decimal   @db.Decimal(8, 2)
  sugars        Decimal   @db.Decimal(8, 2)
  sodium        Decimal   @db.Decimal(8, 2)
  published     Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    User?     @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  entries       DiaryEntry[]

  @@unique([ownerId, barcode])
  @@index([barcode, published])
}

model DiaryEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  day           DateTime  @db.Date
  foodId        String?
  food          Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name          String
  basis         FoodBasis
  amount        Decimal   @db.Decimal(8, 2)
  calories      Decimal   @db.Decimal(10, 2)
  protein       Decimal   @db.Decimal(10, 2)
  carbohydrates Decimal   @db.Decimal(10, 2)
  fat           Decimal   @db.Decimal(10, 2)
  fiber         Decimal   @db.Decimal(10, 2)
  sugars        Decimal   @db.Decimal(10, 2)
  sodium        Decimal   @db.Decimal(10, 2)
  meal          MealCategory @default(snacks)
  createdAt     DateTime  @default(now())

  @@index([userId, day])
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Decimal  @db.Decimal(6, 2)
  loggedAt  DateTime
  source     WeightSource @default(manual)
  externalId String?      @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([userId, externalId])
  @@index([userId, loggedAt])
}

model HealthSettings {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connected           Boolean   @default(false)
  connectedOn         DateTime? @db.Date
  lastSyncedAt        DateTime?
  exerciseGoalMinutes Int       @default(30)
  stepGoal            Int       @default(10000)
}

model HealthDay {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day             DateTime @db.Date
  steps           Int      @default(0)
  exerciseMinutes Int      @default(0)
  activeKcal      Int      @default(0)
  syncedAt        DateTime @default(now())

  @@unique([userId, day])
}

model FastingSettings {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled         Boolean @default(false)
  lengthHours     Int     @default(16)
  startHour       Int     @default(20)
  endHour         Int     @default(12)
  /// Comma-separated lead minutes before startHour: 0, 30, 60. Empty = no lead reminders.
  reminderOffsets String  @default("0") @db.VarChar(32)
}

model FastingTimer {
  userId      String    @id
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime?
  lengthHours Int?
  stoppedAt   DateTime?
}

model FastingSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt   DateTime
  endedAt     DateTime?
  lengthHours Int
  createdAt   DateTime  @default(now())

  @@index([userId, startedAt])
}

// A label scan the user flagged as wrong. Kept so real failures can become
// parser tests (see `npm run export-scan-reports`).
model ScanReport {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo      Bytes
  rawText    String    @db.Text
  parsed     Json
  note       String    @default("") @db.VarChar(500)
  language   String    @db.VarChar(8)
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolvedAt, createdAt])
}
